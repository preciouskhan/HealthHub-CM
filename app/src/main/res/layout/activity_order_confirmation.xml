<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F2F7F3"
    android:gravity="center">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center">

        <!-- Success icon -->
        <TextView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:text="✓"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:gravity="center"
            android:background="#007628"
            android:layout_marginBottom="20dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Order Placed!"
            android:textColor="#0F1A12"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your order has been sent to the pharmacy"
            android:textColor="#7A8F7D"
            android:textSize="13sp"
            android:gravity="center"
            android:layout_marginBottom="28dp"/>

        <!-- Order details card -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#FFFFFF"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tv_order_id"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order ID: ORD-123"
                    android:textColor="#7A8F7D"
                    android:textSize="11sp"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:id="@+id/tv_confirm_drug"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Drug Name"
                    android:textColor="#0F1A12"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_confirm_pharmacy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pharmacy"
                    android:textColor="#007628"
                    android:textSize="13sp"
                    android:layout_marginBottom="8dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#DDE8DF"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_confirm_qty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quantity: 1"
                    android:textColor="#7A8F7D"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tv_confirm_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Total: XAF 0"
                    android:textColor="#007628"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- WhatsApp button -->
        <Button
            android:id="@+id/btn_confirm_whatsapp"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="💬 Contact Pharmacy on WhatsApp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#25D366"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- Back to home -->
        <Button
            android:id="@+id/btn_back_home"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="🏠 Back to Home"
            android:textColor="#007628"
            android:backgroundTint="#E4F5EA"
            android:textStyle="bold"/>

    </LinearLayout>

</LinearLayout>
