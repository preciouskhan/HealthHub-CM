<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Name + Distance -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tv_pharmacy_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Pharmacy Name"
                android:textColor="#0F1A12"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tv_pharmacy_distance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.3 km"
                android:textColor="#007628"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Location -->
        <TextView
            android:id="@+id/tv_pharmacy_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📍 Location"
            android:textColor="#7A8F7D"
            android:textSize="12sp"
            android:layout_marginBottom="8dp"/>

        <!-- Status badge -->
        <TextView
            android:id="@+id/tv_pharmacy_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open Now"
            android:textSize="11sp"
            android:textStyle="bold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="3dp"
            android:layout_marginBottom="12dp"/>

        <!-- Buttons row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- WhatsApp -->
            <Button
                android:id="@+id/btn_whatsapp"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:text="💬 WhatsApp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#25D366"
                android:textSize="12sp"
                android:textStyle="bold"/>

            <!-- Select -->
            <Button
                android:id="@+id/btn_select"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:text="Select →"
                android:textColor="#FFFFFF"
                android:backgroundTint="#007628"
                android:textSize="12sp"
                android:textStyle="bold"/>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
