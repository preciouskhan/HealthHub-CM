<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Name + Category row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_drug_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Drug Name"
                    android:textColor="#0F1A12"
                    android:textSize="15sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tv_drug_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category"
                    android:textColor="#007628"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="#E4F5EA"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"
                    android:layout_marginTop="4dp"/>

            </LinearLayout>

            <TextView
                android:id="@+id/tv_drug_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XAF 500"
                android:textColor="#007628"
                android:textSize="13sp"
                android:textStyle="bold"/>

        </LinearLayout>

        <!-- Description -->
        <TextView
            android:id="@+id/tv_drug_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Description"
            android:textColor="#7A8F7D"
            android:textSize="12sp"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="12dp"/>

        <!-- Find Pharmacy button -->
        <Button
            android:id="@+id/btn_find_pharmacy"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="Find Pharmacy Near Me"
            android:textColor="#FFFFFF"
            android:backgroundTint="#007628"
            android:textStyle="bold"
            android:textSize="13sp"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
