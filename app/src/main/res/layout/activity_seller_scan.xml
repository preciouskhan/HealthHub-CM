<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F2F7F3"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@android:drawable/ic_media_previous"
                android:background="#33007628"
                android:padding="10dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scan &amp; Publish Drug"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginStart="16dp"
                android:textColor="#1F2937" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enter a drug name or scan code to load the product info"
            android:textColor="#475569"
            android:textSize="14sp"
            android:layout_marginBottom="14dp" />

        <EditText
            android:id="@+id/et_scan_input"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Drug name or ID"
            android:paddingHorizontal="16dp"
            android:textSize="16sp"
            android:background="#FFFFFF"
            android:layout_marginBottom="12dp"
            android:inputType="text" />

        <Button
            android:id="@+id/btn_scan_drug"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Scan Drug"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:layout_marginBottom="24dp"
            android:backgroundTint="#0F766E"
            android:textColor="#FFFFFF" />

        <LinearLayout
            android:id="@+id/ll_drug_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:elevation="2dp"
            android:visibility="gone"
            android:layout_marginBottom="20dp">

            <TextView
                android:id="@+id/tv_found_drug_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drug Name"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0F172A"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_found_drug_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textSize="14sp"
                android:textColor="#475569"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_found_drug_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="14sp"
                android:textColor="#475569"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tv_found_drug_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Unit"
                android:textSize="14sp"
                android:textColor="#475569" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_seller_price"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:hint="Set your seller price (XAF)"
            android:paddingHorizontal="16dp"
            android:textSize="16sp"
            android:background="#FFFFFF"
            android:inputType="numberDecimal"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_publish_drug"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Publish Drug"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:backgroundTint="#157EFB"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tv_publish_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#0F766E"
            android:textSize="14sp"
            android:visibility="gone"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>
